# Alpha Vantage API Key - Get yours from https://www.alphavantage.co/support/#api-key
# Copy this file to .env and fill in your API key.
ALPHA_VANTAGE_API_KEY="YOUR_API_KEY_HERE"

# Optional: Override Ticker Symbols (comma-separated, no spaces around commas)
# If not set, the default from config.py will be used.
# Example: TICKER_SYMBOLS="SPY,QQQ,DIA"

# Optional: Override Log Level (e.g., DEBUG, INFO, WARNING, ERROR, CRITICAL)
# If not set, the default from config.py will be used.
# LOG_LEVEL="DEBUG"
